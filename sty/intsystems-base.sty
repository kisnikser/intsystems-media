\graphicspath{{assets/backgrounds/}{assets/people/}{assets/logo/}}

% --- palette: accent + text for each named background -----------------------

\newcommand{\intsys@declarebg}[3]{%
  \pgfkeys{/intsys/bg/#1/alert/.initial=#2}%
  \pgfkeys{/intsys/bg/#1/text/.initial=#3}%
}

